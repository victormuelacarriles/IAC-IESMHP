#!/bin/bash
# =============================================================================
#  iac-actualiza-terraform.sh   ({{ ansible_managed }})
#  Instalado por el rol Ansible 'Terraform'. NO editar a mano: lo regenera el rol.
#
#  Lanza el playbook del rol Terraform en local, como mucho cada {{ terraform_autoactualiza_dias }} días:
#  si Terraform está en la última versión no hace nada; si no, lo actualiza.
#  Lo lanza {{ terraform_autoactualiza_unidad }}.timer {{ terraform_autoactualiza_espera }} después de arrancar
#  (y cada {{ terraform_autoactualiza_intervalo }} si el equipo sigue encendido).
#
#  Log: {{ terraform_autoactualiza_log }} (y journalctl -t iac-terraform)
#  Forzar una comprobación ya:  sudo rm -f {{ terraform_autoactualiza_marca }}; sudo systemctl start {{ terraform_autoactualiza_unidad }}
# =============================================================================
set -u
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/root/.local/bin"

PLAYBOOK="{{ terraform_autoactualiza_playbook }}"
LOG="{{ terraform_autoactualiza_log }}"
MARCA="{{ terraform_autoactualiza_marca }}"
DIAS={{ terraform_autoactualiza_dias }}
HOY="$(date +%F)"

mkdir -p "$(dirname "$LOG")" "$(dirname "$MARCA")"
# Rotación mínima: si pasa de 1 MB, se guarda como .1 y se empieza de nuevo
[ "$(stat -c %s "$LOG" 2>/dev/null || echo 0)" -gt 1048576 ] && mv -f "$LOG" "$LOG.1"
log() { echo "$(date '+%F %T') $*" >> "$LOG"; logger -t iac-terraform "$*"; }

ULTIMA="$(cat "$MARCA" 2>/dev/null)"
if [ -n "$ULTIMA" ] && date -d "$ULTIMA" >/dev/null 2>&1; then
    PASADOS=$(( ( $(date -d "$HOY" +%s) - $(date -d "$ULTIMA" +%s) ) / 86400 ))
    if [ "$PASADOS" -ge 0 ] && [ "$PASADOS" -lt "$DIAS" ]; then
        log "Última comprobación $ULTIMA (hace $PASADOS días, cada $DIAS); nada que hacer."
        exit 0
    fi
fi

if [ ! -f "$PLAYBOOK" ]; then
    log "[ERR] No existe $PLAYBOOK (¿falta el clon del repo?)."
    exit 1
fi
if ! command -v ansible-playbook >/dev/null 2>&1; then
    log "[ERR] ansible-playbook no está instalado."
    exit 1
fi

log "Comprobando Terraform con $PLAYBOOK ..."
ANSIBLE_NOCOLOR=1 ansible-playbook -i localhost, --connection=local "$PLAYBOOK" \
    </dev/null >> "$LOG" 2>&1
RC=$?

if [ $RC -eq 0 ]; then
    echo "$HOY" > "$MARCA"
    log "OK: $({{ terraform_bin_dir }}/terraform version 2>/dev/null | head -n1)"
else
    # Sin marca nueva: se reintenta en el próximo arranque o disparo del timer
    log "[ERR] ansible-playbook devolvió rc=$RC (ver arriba en este log)."
fi
exit $RC
