[Unit]
# {{ ansible_managed }}
# Sin dependencias gráficas: funciona igual sin monitor (headless).
Description=IAC-IESMHP - Instala/actualiza AWS CLI (rol Ansible AWScli)
Documentation=file://{{ awscli_autoactualiza_script }}
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart={{ awscli_autoactualiza_script }}
StandardInput=null
# Prioridad baja: no molestar al alumno que ya está trabajando
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
